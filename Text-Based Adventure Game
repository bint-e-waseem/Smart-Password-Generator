import random
import time

class AdventureGame:
    def __init__(self):
        self.inventory = []
        self.health = 100
        self.location = "start"
        self.game_over = False
        
    def print_slow(self, text, delay=0.03):
        """Print text with a typing effect"""
        for char in text:
            print(char, end='', flush=True)
            time.sleep(delay)
        print()
    
    def show_status(self):
        """Display current game status"""
        print("\n" + "="*50)
        print(f"❤️ Health: {self.health}")
        print(f"🎒 Inventory: {', '.join(self.inventory) if self.inventory else 'Empty'}")
        print("="*50 + "\n")
    
    def get_choice(self, options):
        """Get valid user choice from options"""
        while True:
            print("\nWhat do you do?")
            for i, option in enumerate(options, 1):
                print(f"{i}. {option}")
            
            try:
                choice = int(input("Enter your choice: "))
                if 1 <= choice <= len(options):
                    return choice
                print("Invalid choice. Please try again.")
            except ValueError:
                print("Please enter a number.")
    
    def start_location(self):
        """Starting location - forest clearing"""
        self.print_slow("You wake up in a dark forest clearing...")
        self.print_slow("The moonlight filters through the canopy above.")
        self.print_slow("You hear strange sounds from the shadows around you.")
        
        choice = self.get_choice([
            "Examine the old oak tree",
            "Follow the path to the north",
            "Search the bushes nearby"
        ])
        
        if choice == 1:
            self.oak_tree()
        elif choice == 2:
            self.north_path()
        else:
            self.bushes()
    
    def oak_tree(self):
        """Oak tree encounter"""
        self.print_slow("The ancient oak tree has a hollow opening.")
        self.print_slow("Inside, you find a rusty key and a mysterious note...")
        
        self.inventory.append("Rusty Key")
        self.print_slow("📝 You found: Rusty Key!")
        
        choice = self.get_choice([
            "Read the mysterious note",
            "Continue to the north path",
            "Search the bushes"
        ])
        
        if choice == 1:
            self.print_slow("The note reads: 'The treasure lies where shadows meet light.'")
            self.north_path()
        elif choice == 2:
            self.north_path()
        else:
            self.bushes()
    
    def north_path(self):
        """Northern path encounter"""
        self.print_slow("You walk along the path for a while...")
        
        if "Rusty Key" in self.inventory:
            self.print_slow("You see an old iron gate ahead. Your rusty key might fit!")
            choice = self.get_choice([
                "Use the Rusty Key on the gate",
                "Climb over the gate",
                "Turn back"
            ])
            
            if choice == 1:
                self.gate_room()
            elif choice == 2:
                self.health -= 30
                self.print_slow("You climb over and scrape yourself badly!")
                self.gate_room()
            else:
                self.start_location()
        else:
            self.print_slow("The path leads to a dead end.")
            self.start_location()
    
    def gate_room(self):
        """Room behind the gate"""
        self.print_slow("You enter a hidden chamber filled with ancient artifacts!")
        self.print_slow("In the center sits a golden chest...")
        
        choice = self.get_choice([
            "Open the chest",
            "Examine the wall carvings",
            "Search the room for traps"
        ])
        
        if choice == 1:
            self.treasure_room()
        elif choice == 2:
            self.print_slow("The carvings tell the story of a brave adventurer...")
            self.treasure_room()
        else:
            self.print_slow("You discover a pressure plate trap! You disarm it safely.")
            self.treasure_room()
    
    def treasure_room(self):
        """Final treasure encounter"""
        self.print_slow("✨ As you open the chest, a brilliant light fills the room! ✨")
        self.print_slow("Inside, you find gold, jewels, and an ancient crown!")
        self.print_slow("🎉 CONGRATULATIONS! You've found the lost treasure! 🎉")
        self.show_status()
        self.game_over = True
    
    def bushes(self):
        """Bushes encounter"""
        self.print_slow("You search through the bushes...")
        
        if random.random() < 0.3:  # 30% chance of finding something
            self.print_slow("You find a health potion in the bushes!")
            self.health = min(100, self.health + 30)
            print(f"❤️ Health restored to {self.health}")
        else:
            self.print_slow("You find nothing but thorns. You get scratched!")
            self.health -= 10
            
        self.north_path()
    
    def run(self):
        """Main game loop"""
        self.print_slow("🏰 WELCOME TO THE ADVENTURE OF THE LOST TREASURE! 🏰")
        self.print_slow("Your goal: Find the ancient treasure hidden in the forest.\n")
        
        while not self.game_over and self.health > 0:
            self.show_status()
            
            if self.location == "start":
                self.start_location()
            elif self.location == "north":
                self.north_path()
            elif self.location == "treasure":
                self.treasure_room()
            else:
                self.start_location()
        
        if self.health <= 0:
            self.print_slow("\n💀 GAME OVER - You have succumbed to your wounds...")

# Run the game
if __name__ == "__main__":
    game = AdventureGame()
    game.run()
